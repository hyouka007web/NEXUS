<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">
    <LinearLayout
        android:id="@+id/mediathekTopBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/topbar_height"
        android:gravity="center_vertical"
        android:background="@color/bg_surface"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:id="@+id/mediathekBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_accent_circle"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Zurück"
            app:tint="@color/text_primary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="NEXUS · Mediathek"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mediathekTabs"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:background="@color/bg_surface"
        app:layout_constraintTop_toBottomOf="@id/mediathekTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tabInProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="IN ARBEIT"
            android:textColor="@color/accent_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/ripple_accent" />
        <TextView
            android:id="@+id/tabDownloaded"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="MEINE DOWNLOADS"
            android:textColor="@color/text_muted"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/ripple_accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/mediathekEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:text="@string/mediathek_empty"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/mediathekTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mediathekProgressList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/mediathekTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mediathekGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/mediathekTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
